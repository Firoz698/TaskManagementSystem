@model TaskManagementSystem.Models.FrameEditorViewModel
@{
    ViewData["Title"] = "Photo Frame Editor";
}

<style>
    /* Frame Editor Styles */

    .frame-list {
        max-height: 600px;
        overflow-y: auto;
    }

    .frame-option {
        cursor: pointer;
        border: 2px solid transparent;
        border-radius: 8px;
        padding: 10px;
        transition: all 0.3s ease;
    }

        .frame-option:hover {
            border-color: #007bff;
            background-color: #f8f9fa;
            transform: scale(1.05);
        }

        .frame-option.active {
            border-color: #28a745;
            background-color: #d4edda;
        }

    .frame-thumbnail {
        border-radius: 5px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
    }

    #canvas-container {
        background: linear-gradient(45deg, #f0f0f0 25%, transparent 25%, transparent 75%, #f0f0f0 75%, #f0f0f0), linear-gradient(45deg, #f0f0f0 25%, transparent 25%, transparent 75%, #f0f0f0 75%, #f0f0f0);
        background-size: 20px 20px;
        background-position: 0 0, 10px 10px;
        border: 2px solid #ddd;
        border-radius: 8px;
        width: 600px;
        height: 600px;
        margin: 0 auto;
        position: relative;
        overflow: hidden;
    }

    #editor-canvas {
        cursor: move;
        display: block;
    }

    #frame-overlay {
        width: 600px;
        height: 600px;
    }

    .btn-group .btn {
        flex: 1;
    }

    /* Scrollbar styling */
    .frame-list::-webkit-scrollbar {
        width: 8px;
    }

    .frame-list::-webkit-scrollbar-track {
        background: #f1f1f1;
        border-radius: 10px;
    }

    .frame-list::-webkit-scrollbar-thumb {
        background: #888;
        border-radius: 10px;
    }

        .frame-list::-webkit-scrollbar-thumb:hover {
            background: #555;
        }

    /* Responsive Design */
    @@media (max-width: 768px) {
        #canvas-container

    {
        width: 100%;
        height: auto;
        aspect-ratio: 1;
    }

    #editor-canvas {
        width: 100%;
        height: auto;
    }

    #frame-image {
        width: 100% !important;
        height: auto !important;
    }

    }

    /* Loading Spinner */
    .spinner-border {
        display: none;
    }

    .loading .spinner-border {
        display: inline-block;
    }

    /* Card Animations */
    .card {
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

        .card:hover {
            transform: translateY(-5px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
        }
</style>

<div class="container mt-5">
    <h1 class="text-center mb-4">Photo Frame Editor</h1>

    <div class="row">
        <!-- Frame Selection Panel -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0">Select Frame</h5>
                </div>
                <div class="card-body frame-list">
                    @foreach (var frame in Model.AvailableFrames)
                    {
                        <div class="frame-option mb-3" data-frame-id="@frame.Id" data-frame-path="@frame.ImagePath">
                            <img src="@frame.ImagePath" alt="@frame.Name" class="img-fluid frame-thumbnail" />
                            <p class="text-center mt-2 mb-0">@frame.Name</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Editor Canvas -->
        <div class="col-md-6">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0">Editor</h5>
                </div>
                <div class="card-body">
                    <div id="canvas-container" class="position-relative">
                        <canvas id="editor-canvas" width="600" height="600"></canvas>
                        <div id="frame-overlay" class="position-absolute" style="top: 0; left: 0; pointer-events: none;">
                            <img id="frame-image" src="" alt="Frame" style="width: 600px; height: 600px; display: none;" />
                        </div>
                    </div>

                    <div class="mt-3">
                        <input type="file" id="photo-upload" accept="image/*" class="form-control mb-3" />

                        <div class="btn-group w-100 mb-2" role="group">
                            <button id="zoom-in" class="btn btn-outline-secondary">
                                <i class="bi bi-zoom-in"></i> Zoom In
                            </button>
                            <button id="zoom-out" class="btn btn-outline-secondary">
                                <i class="bi bi-zoom-out"></i> Zoom Out
                            </button>
                            <button id="reset-position" class="btn btn-outline-warning">
                                <i class="bi bi-arrow-clockwise"></i> Reset
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Controls Panel -->
        <div class="col-md-3">
            <div class="card">
                <div class="card-header bg-info text-white">
                    <h5 class="mb-0">Controls</h5>
                </div>
                <div class="card-body">
                    <div class="mb-3">
                        <label class="form-label">Zoom Level: <span id="zoom-level">100</span>%</label>
                        <input type="range" class="form-range" id="zoom-slider" min="50" max="200" value="100" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Position X: <span id="pos-x">0</span>px</label>
                        <input type="range" class="form-range" id="position-x" min="-300" max="300" value="0" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Position Y: <span id="pos-y">0</span>px</label>
                        <input type="range" class="form-range" id="position-y" min="-300" max="300" value="0" />
                    </div>

                    <button id="download-btn" class="btn btn-success w-100 mb-2">
                        <i class="bi bi-download"></i> Download Photo
                    </button>

                    <button id="clear-btn" class="btn btn-danger w-100">
                        <i class="bi bi-trash"></i> Clear All
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    // Frame Editor JavaScript

    class FrameEditor {
        constructor() {
            this.canvas = document.getElementById('editor-canvas');
            this.ctx = this.canvas.getContext('2d');
            this.frameImage = document.getElementById('frame-image');
            this.uploadedImage = null;

            // Image properties
            this.imageX = 0;
            this.imageY = 0;
            this.imageScale = 1;
            this.isDragging = false;
            this.lastX = 0;
            this.lastY = 0;

            this.selectedFrame = null;

            this.initializeEventListeners();
        }

        initializeEventListeners() {
            // Frame selection
            document.querySelectorAll('.frame-option').forEach(frame => {
                frame.addEventListener('click', (e) => this.selectFrame(e.currentTarget));
            });

            // Photo upload
            document.getElementById('photo-upload').addEventListener('change', (e) => this.handlePhotoUpload(e));

            // Canvas drag events
            this.canvas.addEventListener('mousedown', (e) => this.startDrag(e));
            this.canvas.addEventListener('mousemove', (e) => this.drag(e));
            this.canvas.addEventListener('mouseup', () => this.stopDrag());
            this.canvas.addEventListener('mouseleave', () => this.stopDrag());

            // Touch events for mobile
            this.canvas.addEventListener('touchstart', (e) => this.startDrag(e.touches[0]));
            this.canvas.addEventListener('touchmove', (e) => {
                e.preventDefault();
                this.drag(e.touches[0]);
            });
            this.canvas.addEventListener('touchend', () => this.stopDrag());

            // Control buttons
            document.getElementById('zoom-in').addEventListener('click', () => this.zoomIn());
            document.getElementById('zoom-out').addEventListener('click', () => this.zoomOut());
            document.getElementById('reset-position').addEventListener('click', () => this.resetPosition());
            document.getElementById('download-btn').addEventListener('click', () => this.downloadImage());
            document.getElementById('clear-btn').addEventListener('click', () => this.clearAll());

            // Sliders
            document.getElementById('zoom-slider').addEventListener('input', (e) => this.handleZoomSlider(e));
            document.getElementById('position-x').addEventListener('input', (e) => this.handlePositionX(e));
            document.getElementById('position-y').addEventListener('input', (e) => this.handlePositionY(e));
        }

        selectFrame(frameElement) {
            // Remove active class from all frames
            document.querySelectorAll('.frame-option').forEach(f => f.classList.remove('active'));

            // Add active class to selected frame
            frameElement.classList.add('active');

            // Get frame path
            const framePath = frameElement.dataset.framePath;
            this.selectedFrame = framePath;

            // Load and display frame
            this.frameImage.src = framePath;
            this.frameImage.style.display = 'block';

            this.redrawCanvas();
        }

        handlePhotoUpload(event) {
            const file = event.target.files[0];
            if (!file) return;

            const reader = new FileReader();
            reader.onload = (e) => {
                const img = new Image();
                img.onload = () => {
                    this.uploadedImage = img;
                    this.resetPosition();
                    this.redrawCanvas();
                };
                img.src = e.target.result;
            };
            reader.readAsDataURL(file);
        }

        startDrag(e) {
            if (!this.uploadedImage) return;

            this.isDragging = true;
            this.lastX = e.clientX || e.pageX;
            this.lastY = e.clientY || e.pageY;
        }

        drag(e) {
            if (!this.isDragging || !this.uploadedImage) return;

            const currentX = e.clientX || e.pageX;
            const currentY = e.clientY || e.pageY;

            const deltaX = currentX - this.lastX;
            const deltaY = currentY - this.lastY;

            this.imageX += deltaX;
            this.imageY += deltaY;

            this.lastX = currentX;
            this.lastY = currentY;

            this.updatePositionSliders();
            this.redrawCanvas();
        }

        stopDrag() {
            this.isDragging = false;
        }

        zoomIn() {
            this.imageScale = Math.min(this.imageScale + 0.1, 3);
            this.updateZoomSlider();
            this.redrawCanvas();
        }

        zoomOut() {
            this.imageScale = Math.max(this.imageScale - 0.1, 0.1);
            this.updateZoomSlider();
            this.redrawCanvas();
        }

        handleZoomSlider(event) {
            this.imageScale = event.target.value / 100;
            document.getElementById('zoom-level').textContent = event.target.value;
            this.redrawCanvas();
        }

        handlePositionX(event) {
            this.imageX = parseInt(event.target.value);
            document.getElementById('pos-x').textContent = event.target.value;
            this.redrawCanvas();
        }

        handlePositionY(event) {
            this.imageY = parseInt(event.target.value);
            document.getElementById('pos-y').textContent = event.target.value;
            this.redrawCanvas();
        }

        updateZoomSlider() {
            const zoomValue = Math.round(this.imageScale * 100);
            document.getElementById('zoom-slider').value = zoomValue;
            document.getElementById('zoom-level').textContent = zoomValue;
        }

        updatePositionSliders() {
            document.getElementById('position-x').value = Math.round(this.imageX);
            document.getElementById('position-y').value = Math.round(this.imageY);
            document.getElementById('pos-x').textContent = Math.round(this.imageX);
            document.getElementById('pos-y').textContent = Math.round(this.imageY);
        }

        resetPosition() {
            this.imageX = 0;
            this.imageY = 0;
            this.imageScale = 1;
            this.updateZoomSlider();
            this.updatePositionSliders();
            this.redrawCanvas();
        }

        redrawCanvas() {
            // Clear canvas
            this.ctx.clearRect(0, 0, this.canvas.width, this.canvas.height);

            // Draw uploaded image if exists
            if (this.uploadedImage) {
                this.ctx.save();

                // Calculate scaled dimensions
                const scaledWidth = this.uploadedImage.width * this.imageScale;
                const scaledHeight = this.uploadedImage.height * this.imageScale;

                // Center the image and apply position offset
                const centerX = (this.canvas.width - scaledWidth) / 2 + this.imageX;
                const centerY = (this.canvas.height - scaledHeight) / 2 + this.imageY;

                this.ctx.drawImage(
                    this.uploadedImage,
                    centerX,
                    centerY,
                    scaledWidth,
                    scaledHeight
                );

                this.ctx.restore();
            }
        }

        downloadImage() {
            if (!this.uploadedImage) {
                alert('Please upload a photo first!');
                return;
            }

            // Create a temporary canvas for the final image
            const tempCanvas = document.createElement('canvas');
            tempCanvas.width = this.canvas.width;
            tempCanvas.height = this.canvas.height;
            const tempCtx = tempCanvas.getContext('2d');

            // Draw the photo
            const scaledWidth = this.uploadedImage.width * this.imageScale;
            const scaledHeight = this.uploadedImage.height * this.imageScale;
            const centerX = (tempCanvas.width - scaledWidth) / 2 + this.imageX;
            const centerY = (tempCanvas.height - scaledHeight) / 2 + this.imageY;

            tempCtx.drawImage(
                this.uploadedImage,
                centerX,
                centerY,
                scaledWidth,
                scaledHeight
            );

            // Draw the frame on top if selected
            if (this.selectedFrame && this.frameImage.complete) {
                tempCtx.drawImage(this.frameImage, 0, 0, tempCanvas.width, tempCanvas.height);
            }

            // Convert to blob and download
            tempCanvas.toBlob((blob) => {
                const url = URL.createObjectURL(blob);
                const link = document.createElement('a');
                link.href = url;
                link.download = 'framed-photo-' + Date.now() + '.png';
                document.body.appendChild(link);
                link.click();
                document.body.removeChild(link);
                URL.revokeObjectURL(url);
            });
        }

        clearAll() {
            if (confirm('Are you sure you want to clear everything?')) {
                this.uploadedImage = null;
                this.selectedFrame = null;
                this.frameImage.style.display = 'none';
                this.frameImage.src = '';
                this.resetPosition();
                this.redrawCanvas();

                document.getElementById('photo-upload').value = '';
                document.querySelectorAll('.frame-option').forEach(f => f.classList.remove('active'));
            }
        }
    }

    // Initialize the editor when DOM is ready
    document.addEventListener('DOMContentLoaded', () => {
        const editor = new FrameEditor();
    });
</script>
