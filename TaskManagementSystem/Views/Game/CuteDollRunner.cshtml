@{
    ViewData["Title"] = "Cute Doll Runner";
}

<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

<style>
    :root {
        --pink: #ec4899;
        --pink2: #db2777;
        --neon: #f9a8d4;
        --purple: #a855f7;
        --yellow: #fbbf24;
        --green: #22c55e;
        --red: #ef4444;
        --bg: #0f0614;
        --card: #180920;
        --border: #3b1063;
        --text: #fce7f3;
        --muted: #9ca3af;
        --pixel: 'Press Start 2P', monospace;
        --body: 'Nunito', sans-serif;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--body);
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
    }

    /* ── Page Header ── */
    .game-header {
        text-align: center;
        padding: 28px 20px 16px;
    }

    .game-title {
        font-family: var(--pixel);
        font-size: clamp(14px, 3vw, 22px);
        color: var(--neon);
        text-shadow: 0 0 20px rgba(249,168,212,0.6), 0 0 40px rgba(249,168,212,0.3);
        letter-spacing: 2px;
        animation: titlePulse 2.5s ease-in-out infinite;
    }

    @@keyframes titlePulse {
        0%, 100% {
            text-shadow: 0 0 20px rgba(249,168,212,0.6), 0 0 40px rgba(249,168,212,0.3);
        }

        50% {
            text-shadow: 0 0 30px rgba(249,168,212,0.9), 0 0 60px rgba(249,168,212,0.5);
        }
    }

    .game-subtitle {
        font-size: 13px;
        color: var(--muted);
        margin-top: 8px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    /* ── Main layout ── */
    .game-layout {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 20px;
        padding: 0 16px 40px;
        flex-wrap: wrap;
    }

    /* ── Canvas wrapper ── */
    .canvas-wrap {
        position: relative;
        flex-shrink: 0;
    }

    #gameCanvas {
        display: block;
        border: 2px solid var(--border);
        border-radius: 14px;
        background: #080410;
        box-shadow: 0 0 0 1px var(--border), 0 0 50px rgba(168,85,247,0.10), inset 0 0 60px rgba(0,0,0,0.6);
        max-width: 100%;
        height: auto;
    }

    /* Overlay */
    .canvas-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        background: rgba(8,4,16,0.92);
        backdrop-filter: blur(3px);
        z-index: 10;
        transition: opacity 0.3s;
    }

        .canvas-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

    .overlay-icon {
        font-size: clamp(36px,5vw,56px);
        margin-bottom: 14px;
        animation: bounceIn 0.5s ease both;
    }

    .overlay-title {
        font-family: var(--pixel);
        font-size: clamp(10px,1.5vw,15px);
        color: var(--neon);
        text-shadow: 0 0 16px rgba(249,168,212,0.7);
        margin-bottom: 10px;
        text-align: center;
        padding: 0 16px;
    }

    .overlay-sub {
        font-size: 13px;
        color: var(--muted);
        font-weight: 600;
        text-align: center;
    }

    .overlay-score {
        font-family: var(--pixel);
        font-size: clamp(9px,1.4vw,12px);
        color: var(--yellow);
        margin: 14px 0 4px;
    }

    @@keyframes bounceIn {
        0% {
            transform: scale(0.4);
            opacity: 0;
        }

        70% {
            transform: scale(1.12);
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* ── Side Panel ── */
    .side-panel {
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-width: 210px;
        max-width: 240px;
        flex: 1;
    }

    .panel-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px;
    }

    .panel-card-title {
        font-family: var(--pixel);
        font-size: 9px;
        color: var(--neon);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    /* Score */
    .score-display {
        display: flex;
        justify-content: space-between;
        gap: 10px;
    }

    .score-box {
        flex: 1;
        background: #0d0518;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 12px 8px;
        text-align: center;
    }

        .score-box .label {
            font-size: 10px;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 4px;
        }

        .score-box .value {
            font-family: var(--pixel);
            font-size: clamp(12px,2.5vw,18px);
            color: var(--yellow);
            text-shadow: 0 0 12px rgba(251,191,36,0.5);
        }

        .score-box.best .value {
            color: var(--neon);
            text-shadow: 0 0 12px rgba(249,168,212,0.5);
        }

    /* Speed bar */
    .dist-row {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-top: 4px;
    }

    .dist-label {
        font-size: 12px;
        color: var(--muted);
        font-weight: 700;
        min-width: 44px;
    }

    .bar-wrap {
        flex: 1;
        height: 8px;
        background: #1a0a2e;
        border-radius: 4px;
        overflow: hidden;
    }

    .bar-fill {
        height: 100%;
        width: 0%;
        background: linear-gradient(90deg, var(--pink2), var(--pink));
        border-radius: 4px;
        transition: width 0.4s ease;
        box-shadow: 0 0 8px rgba(236,72,153,0.4);
    }

    /* Buttons */
    .game-btns {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .gbtn {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 11px 14px;
        font-family: var(--body);
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        letter-spacing: 0.3px;
    }

    .gbtn-start {
        background: linear-gradient(135deg,#be185d,#ec4899);
        color: #fff;
        box-shadow: 0 4px 14px rgba(236,72,153,0.3);
    }

    .gbtn-pause {
        background: linear-gradient(135deg,#d97706,#fbbf24);
        color: #fff;
        box-shadow: 0 4px 14px rgba(251,191,36,0.25);
    }

    .gbtn-reset {
        background: linear-gradient(135deg,#b91c1c,#ef4444);
        color: #fff;
        box-shadow: 0 4px 14px rgba(239,68,68,0.25);
    }

    .gbtn:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
    }

    .gbtn:active {
        transform: translateY(0);
        filter: brightness(0.95);
    }

    .gbtn i {
        font-size: 16px;
    }

    /* Jump button */
    .jump-btn {
        width: 100%;
        border: 2px solid rgba(249,168,212,0.3);
        border-radius: 12px;
        padding: 14px 0;
        background: rgba(236,72,153,0.1);
        color: var(--neon);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: all 0.12s;
        font-family: var(--body);
        font-size: 14px;
        font-weight: 800;
        margin-top: 8px;
    }

        .jump-btn:hover {
            background: rgba(236,72,153,0.2);
            box-shadow: 0 0 18px rgba(236,72,153,0.3);
        }

        .jump-btn:active {
            transform: scale(0.96);
        }

        .jump-btn i {
            font-size: 20px;
        }

    /* Leaderboard */
    .lb-row {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 7px 10px;
        border-radius: 8px;
        margin-bottom: 4px;
        background: #0d0518;
        font-size: 13px;
        font-weight: 700;
    }

    .lb-rank {
        font-family: var(--pixel);
        font-size: 9px;
        color: var(--muted);
        min-width: 20px;
    }

        .lb-rank.gold {
            color: #fbbf24;
        }

        .lb-rank.silver {
            color: #94a3b8;
        }

        .lb-rank.bronze {
            color: #b45309;
        }

    .lb-name {
        flex: 1;
        color: var(--text);
        font-size: 12px;
    }

    .lb-score {
        font-family: var(--pixel);
        font-size: 9px;
        color: var(--neon);
    }

    /* ── Responsive ── */
    @@media (max-width: 700px) {
        .game-layout {
            gap: 14px;
            padding: 0 10px 30px;
        }

        .side-panel {
            max-width: 100%;
            min-width: unset;
            width: 100%;
            flex-direction: row;
            flex-wrap: wrap;
        }

        .panel-card {
            flex: 1;
            min-width: 140px;
        }

        #gameCanvas {
            width: 100% !important;
            height: auto !important;
        }
    }
</style>

<!-- ══ Page Header ══ -->
<div class="game-header">
    <div class="game-title">💃 CUTE DOLL RUNNER</div>
    <div class="game-subtitle">Space / Tap = Jump over obstacles!</div>
</div>

<!-- ══ Game Layout ══ -->
<div class="game-layout">

    <!-- Canvas -->
    <div class="canvas-wrap">
        <canvas id="gameCanvas" width="600" height="300"></canvas>
        <div class="canvas-overlay" id="overlay">
            <div class="overlay-icon">💃</div>
            <div class="overlay-title">READY TO RUN?</div>
            <div class="overlay-sub">Press Start or Space to jump</div>
        </div>
    </div>

    <!-- Side Panel -->
    <div class="side-panel">

        <!-- Score -->
        <div class="panel-card">
            <div class="panel-card-title"><i class="bi bi-trophy-fill"></i> Score</div>
            <div class="score-display">
                <div class="score-box">
                    <div class="label">Now</div>
                    <div class="value" id="scoreVal">0</div>
                </div>
                <div class="score-box best">
                    <div class="label">Best</div>
                    <div class="value" id="bestVal">0</div>
                </div>
            </div>
            <div class="dist-row" style="margin-top:10px;">
                <div class="dist-label">Speed</div>
                <div class="bar-wrap"><div class="bar-fill" id="speedBar"></div></div>
                <div style="font-size:11px;color:var(--muted);min-width:32px;text-align:right;" id="speedVal">1x</div>
            </div>
        </div>

        <!-- Controls -->
        <div class="panel-card">
            <div class="panel-card-title"><i class="bi bi-joystick"></i> Controls</div>
            <div class="game-btns">
                <button class="gbtn gbtn-start" id="startBtn"><i class="bi bi-play-fill"></i> Start</button>
                <button class="gbtn gbtn-pause" id="pauseBtn"><i class="bi bi-pause-fill"></i> Pause</button>
                <button class="gbtn gbtn-reset" id="resetBtn"><i class="bi bi-arrow-counterclockwise"></i> Reset</button>
            </div>
            <button class="jump-btn" id="jumpBtn"><i class="bi bi-arrow-up-circle-fill"></i> JUMP!</button>
        </div>

        <!-- How to play -->
        <div class="panel-card">
            <div class="panel-card-title"><i class="bi bi-info-circle-fill"></i> How to Play</div>
            <div style="font-size:12px;color:var(--muted);line-height:1.9;font-weight:600;">
                <div>🎮 Press <span style="color:var(--neon)">Space</span> to jump</div>
                <div>💃 Avoid obstacles</div>
                <div>⚡ Speed increases over time</div>
                <div>🌟 Survive as long as possible!</div>
            </div>
        </div>

        <!-- Leaderboard -->
        <div class="panel-card">
            <div class="panel-card-title"><i class="bi bi-bar-chart-fill"></i> Top Scores</div>
            <div id="leaderboard">
                <div style="font-size:12px;color:var(--muted);text-align:center;padding:10px 0;">Play to set a score!</div>
            </div>
        </div>

    </div>
</div>

<script>
    (function(){
        const canvas = document.getElementById("gameCanvas");
        const ctx    = canvas.getContext("2d");
        const W = canvas.width;
        const H = canvas.height;

        /* ── Constants ── */
        const GROUND_Y  = H - Math.floor(H * 0.20);
        const DOLL_X    = 100;
        const DOLL_W    = 36, DOLL_H = 50;
        const GRAVITY   = 0.55;
        const JUMP_V    = -13;

        /* ── State ── */
        let dollY, dollVY, isJumping;
        let obstacles=[], clouds=[], bgStars=[];
        let score=0, bestScore=0, gameSpeed=3;
        let frameCount=0, obsTimer=0, obsInterval=90;
        let running=false, paused=false, sessionSaved=false, startedAt=null;
        let timerInterval=null, elapsedSeconds=0;
        let animId=null;

        bgStars = Array.from({length:60}, ()=>({
            x: Math.random()*100, y: Math.random()*60,
            r: Math.random()<0.3?1.5:0.8, a:0.3+Math.random()*0.5
        }));

        function getDollY() { return GROUND_Y - DOLL_H; }

        function initState() {
            dollY=getDollY(); dollVY=0; isJumping=false;
            obstacles=[]; clouds=[];
            score=0; gameSpeed=3; frameCount=0; obsTimer=0; obsInterval=90;
            running=false; paused=false; sessionSaved=false; startedAt=null; elapsedSeconds=0;
            updateUI();
        }

        /* ── Draw ── */
        function draw() {
            const sky = ctx.createLinearGradient(0,0,0,GROUND_Y);
            sky.addColorStop(0,"#0f0614"); sky.addColorStop(1,"#1e0a30");
            ctx.fillStyle = sky; ctx.fillRect(0,0,W,GROUND_Y);

            const grd = ctx.createLinearGradient(0,GROUND_Y,0,H);
            grd.addColorStop(0,"#7e22ce"); grd.addColorStop(1,"#4a044e");
            ctx.fillStyle = grd; ctx.fillRect(0,GROUND_Y,W,H-GROUND_Y);
            ctx.fillStyle="rgba(249,168,212,0.15)"; ctx.fillRect(0,GROUND_Y,W,3);

            bgStars.forEach(s=>{
                ctx.fillStyle=`rgba(249,168,212,${s.a})`;
                ctx.beginPath(); ctx.arc(s.x/100*W, s.y/100*GROUND_Y, s.r,0,Math.PI*2); ctx.fill();
            });

            clouds.forEach(c=>{
                ctx.globalAlpha=0.18; ctx.fillStyle="#f9a8d4";
                ctx.beginPath(); ctx.arc(c.x,c.y,c.r,0,Math.PI*2); ctx.fill();
                ctx.beginPath(); ctx.arc(c.x+c.r*0.8,c.y+4,c.r*0.7,0,Math.PI*2); ctx.fill();
                ctx.beginPath(); ctx.arc(c.x-c.r*0.7,c.y+5,c.r*0.65,0,Math.PI*2); ctx.fill();
                ctx.globalAlpha=1;
            });

            obstacles.forEach(ob=>{
                ctx.shadowColor="#ef4444"; ctx.shadowBlur=10;
                ctx.fillStyle="#7f1d1d";
                ctx.beginPath(); ctx.roundRect(ob.x,GROUND_Y-ob.h,ob.w,ob.h,[4,4,0,0]); ctx.fill();
                ctx.fillStyle="#ef4444";
                ctx.beginPath(); ctx.roundRect(ob.x+3,GROUND_Y-ob.h+4,ob.w-6,ob.h-8,2); ctx.fill();
                ctx.fillStyle="#fca5a5";
                for(let i=0;i<3;i++){
                    const sx=ob.x+ob.w/2-6+i*6;
                    ctx.beginPath(); ctx.moveTo(sx,GROUND_Y-ob.h); ctx.lineTo(sx-3,GROUND_Y-ob.h+8); ctx.lineTo(sx+3,GROUND_Y-ob.h+8); ctx.closePath(); ctx.fill();
                }
                ctx.shadowBlur=0;
            });

            drawDoll(DOLL_X, dollY);
        }

        function drawDoll(x,y){
            ctx.fillStyle="rgba(168,85,247,0.25)";
            ctx.beginPath(); ctx.ellipse(x+DOLL_W/2,GROUND_Y+2,DOLL_W*0.4,4,0,0,Math.PI*2); ctx.fill();

            ctx.shadowColor="#ec4899"; ctx.shadowBlur=14;
            ctx.fillStyle="#ec4899";
            ctx.beginPath(); ctx.moveTo(x+DOLL_W/2-4,y+20); ctx.lineTo(x+DOLL_W-2,y+DOLL_H); ctx.lineTo(x+2,y+DOLL_H); ctx.closePath(); ctx.fill();

            ctx.fillStyle="#f9a8d4";
            ctx.beginPath(); ctx.roundRect(x+DOLL_W/2-7,y+12,14,16,4); ctx.fill();

            ctx.fillStyle="#fde68a";
            ctx.beginPath(); ctx.arc(x+DOLL_W/2,y+9,10,0,Math.PI*2); ctx.fill();

            ctx.fillStyle="#7c3aed";
            ctx.beginPath(); ctx.arc(x+DOLL_W/2,y+3,10,Math.PI,0,false); ctx.fill();
            ctx.beginPath(); ctx.arc(x+DOLL_W/2-8,y+8,5,0,Math.PI*2); ctx.fill();
            ctx.beginPath(); ctx.arc(x+DOLL_W/2+8,y+8,5,0,Math.PI*2); ctx.fill();

            ctx.fillStyle="#1e0a30";
            ctx.beginPath(); ctx.arc(x+DOLL_W/2-4,y+9,2.5,0,Math.PI*2); ctx.fill();
            ctx.beginPath(); ctx.arc(x+DOLL_W/2+4,y+9,2.5,0,Math.PI*2); ctx.fill();

            ctx.strokeStyle="#db2777"; ctx.lineWidth=1.5;
            ctx.beginPath(); ctx.arc(x+DOLL_W/2,y+12,4,0,Math.PI); ctx.stroke();
            ctx.shadowBlur=0;
        }

        /* ── Logic ── */
        function update(){
            dollVY+=GRAVITY; dollY+=dollVY;
            if(dollY>=getDollY()){dollY=getDollY();dollVY=0;isJumping=false;}

            if(frameCount%120===0) clouds.push({x:W+60,y:30+Math.random()*(GROUND_Y*0.4),r:20+Math.random()*20});
            clouds.forEach(c=>c.x-=gameSpeed*0.3);
            clouds=clouds.filter(c=>c.x>-80);

            obsTimer++;
            if(obsTimer>=obsInterval){
                const h=35+Math.random()*35;
                obstacles.push({x:W,w:22+Math.random()*14,h});
                obsTimer=0; obsInterval=Math.max(45,obsInterval-0.5);
            }
            obstacles.forEach(ob=>ob.x-=gameSpeed);
            obstacles=obstacles.filter(ob=>ob.x>-60);

            if(frameCount%200===0&&gameSpeed<12){gameSpeed+=0.3;updateUI();}

            for(const ob of obstacles){
                const dL=DOLL_X+8,dR=DOLL_X+DOLL_W-8;
                const dT=dollY+4,dB=dollY+DOLL_H;
                if(dR>ob.x&&dL<ob.x+ob.w&&dB>GROUND_Y-ob.h+4) return gameOver();
            }

            score++;
            if(score>bestScore){bestScore=score;localStorage.setItem("dollBest",bestScore);}
            updateUI(); draw(); frameCount++;
        }

        function gameOver(){
            stopAll();
            showOverlay("💔","GAME OVER","Press Reset to try again",true);
            saveSession("GameOver");
        }

        /* ── Controls ── */
        function jump(){
            if(!running||isJumping) return;
            dollVY=JUMP_V; isJumping=true;
        }

        function startGame(){
            if(running&&!paused) return;
            hideOverlay();
            if(!startedAt){startedAt=new Date();}
            paused=false; running=true;
            if(timerInterval) clearInterval(timerInterval);
            timerInterval=setInterval(()=>{elapsedSeconds++;},1000);
            if(animId) cancelAnimationFrame(animId);
            loop();
        }

        function loop(){
            if(!running){return;}
            update();
            animId=requestAnimationFrame(loop);
        }

        function pauseGame(){
            if(!running) return;
            running=false; paused=true;
            cancelAnimationFrame(animId);
            clearInterval(timerInterval);
            showOverlay("⏸️","PAUSED","Press Start to continue",false);
        }

        function resetGame(){
            stopAll(); initState(); draw();
            showOverlay("💃","READY TO RUN?","Press Start or Space to jump",false);
        }

        function stopAll(){
            running=false; paused=false;
            if(animId) cancelAnimationFrame(animId);
            clearInterval(timerInterval); timerInterval=null;
        }

        function updateUI(){
            document.getElementById("scoreVal").textContent=Math.floor(score/10);
            document.getElementById("bestVal").textContent=Math.floor(bestScore/10);
            const sp=Math.min((gameSpeed-3)/9*100,100);
            document.getElementById("speedBar").style.width=sp+"%";
            document.getElementById("speedVal").textContent=(gameSpeed/3).toFixed(1)+"x";
        }

        function showOverlay(icon,title,sub,showScore){
            const ov=document.getElementById("overlay");
            const pts=Math.floor(score/10);
            ov.innerHTML=`<div class="overlay-icon">${icon}</div>
                <div class="overlay-title">${title}</div>
                ${showScore?`<div class="overlay-score">SCORE: ${pts}</div>`:""}
                <div class="overlay-sub">${sub}</div>`;
            ov.classList.remove("hidden");
        }
        function hideOverlay(){document.getElementById("overlay").classList.add("hidden");}

        /* ── Input ── */
        document.addEventListener("keydown",e=>{
            if(e.code==="Space"||e.key==="ArrowUp"){e.preventDefault();running?jump():startGame();}
        });
        document.getElementById("jumpBtn").addEventListener("click",()=>running?jump():startGame());
        document.getElementById("startBtn").addEventListener("click",startGame);
        document.getElementById("pauseBtn").addEventListener("click",pauseGame);
        document.getElementById("resetBtn").addEventListener("click",resetGame);
        canvas.addEventListener("click",()=>running?jump():startGame());
        canvas.addEventListener("touchstart",e=>{e.preventDefault();running?jump():startGame();},{passive:false});

        /* ── Save session ── */
        function saveSession(result){
            if(sessionSaved) return; sessionSaved=true;
            const pts=Math.floor(score/10);
            if(pts===0) return;
            fetch('/Game/SaveSession',{method:'POST',headers:{'Content-Type':'application/json'},
                body:JSON.stringify({gameName:"CuteDollRunner",score:pts,durationSeconds:elapsedSeconds,result,startedAt:startedAt?startedAt.toISOString():new Date().toISOString()})
            }).then(r=>r.json()).then(()=>loadLeaderboard()).catch(()=>{});
        }

        function loadLeaderboard(){
            fetch('/Game/Leaderboard?gameName=CuteDollRunner')
                .then(r=>r.json())
                .then(data=>{
                    const lb=document.getElementById("leaderboard");
                    if(!data.length){lb.innerHTML='<div style="font-size:12px;color:var(--muted);text-align:center;padding:10px 0;">No scores yet!</div>';return;}
                    const rc=["gold","silver","bronze"];
                    lb.innerHTML=data.map((row,i)=>`
                        <div class="lb-row">
                            <div class="lb-rank ${rc[i]||''}">#${i+1}</div>
                            <div class="lb-name">${row.userName??"Guest"}</div>
                            <div class="lb-score">${row.score}</div>
                        </div>`).join('');
                }).catch(()=>{});
        }

        /* ── Init ── */
        bestScore=parseInt(localStorage.getItem("dollBest")||"0");
        initState(); draw();
        showOverlay("💃","READY TO RUN?","Press Start or Space to jump",false);
        loadLeaderboard();
    })();
</script>
