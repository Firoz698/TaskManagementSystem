@{
    ViewData["Title"] = "Tic-Tac-Toe Game";
}

<link href="https://fonts.googleapis.com/css2?family=Press+Start+2P&family=Nunito:wght@400;600;700;800&display=swap" rel="stylesheet" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

<style>
    :root {
        --blue: #3b82f6;
        --blue2: #2563eb;
        --neon: #60a5fa;
        --orange: #f97316;
        --yellow: #fbbf24;
        --red: #ef4444;
        --green: #22c55e;
        --bg: #080c14;
        --card: #0f1623;
        --border: #1e2d4a;
        --text: #dbeafe;
        --muted: #6b7280;
        --pixel: 'Press Start 2P', monospace;
        --body: 'Nunito', sans-serif;
    }

    * {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    body {
        font-family: var(--body);
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
    }

    .game-header {
        text-align: center;
        padding: 28px 20px 16px;
    }

    .game-title {
        font-family: var(--pixel);
        font-size: clamp(14px, 3vw, 22px);
        color: var(--neon);
        text-shadow: 0 0 20px rgba(96,165,250,0.6), 0 0 40px rgba(96,165,250,0.3);
        letter-spacing: 2px;
        animation: titlePulse 2.5s ease-in-out infinite;
    }

    @@keyframes titlePulse {
        0%, 100% {
            text-shadow: 0 0 20px rgba(96,165,250,0.6), 0 0 40px rgba(96,165,250,0.3);
        }

        50% {
            text-shadow: 0 0 30px rgba(96,165,250,0.9), 0 0 60px rgba(96,165,250,0.5);
        }
    }

    .game-subtitle {
        font-size: 13px;
        color: var(--muted);
        margin-top: 8px;
        font-weight: 600;
        letter-spacing: 1px;
        text-transform: uppercase;
    }

    .game-layout {
        display: flex;
        justify-content: center;
        align-items: flex-start;
        gap: 20px;
        padding: 0 16px 40px;
        flex-wrap: wrap;
    }

    /* ── Canvas ── */
    .canvas-wrap {
        position: relative;
        flex-shrink: 1;
        min-width: 0;
        width: min(1200px, calc(100vw - 32px));
    }

    #gameCanvas {
        display: block;
        width: 100%;
        height: auto;
        border: 2px solid var(--border);
        border-radius: 12px;
        background: #050a14;
        box-shadow: 0 0 0 1px var(--border), 0 0 40px rgba(59,130,246,0.08), inset 0 0 60px rgba(0,0,0,0.6);
        cursor: pointer;
    }

    .canvas-overlay {
        position: absolute;
        inset: 0;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        background: rgba(5,10,20,0.90);
        backdrop-filter: blur(3px);
        z-index: 10;
        transition: opacity 0.3s;
    }

        .canvas-overlay.hidden {
            opacity: 0;
            pointer-events: none;
        }

    .overlay-icon {
        font-size: clamp(40px,5vw,60px);
        margin-bottom: 14px;
        animation: bounceIn 0.5s ease both;
    }

    .overlay-title {
        font-family: var(--pixel);
        font-size: clamp(10px,2vw,18px);
        color: var(--neon);
        text-shadow: 0 0 16px rgba(96,165,250,0.7);
        margin-bottom: 10px;
        text-align: center;
    }

    .overlay-sub {
        font-size: 14px;
        color: var(--muted);
        font-weight: 600;
        text-align: center;
    }

    .overlay-score {
        font-family: var(--pixel);
        font-size: clamp(9px,1.5vw,13px);
        color: var(--yellow);
        margin: 14px 0 4px;
        text-align: center;
    }

    @@keyframes bounceIn {
        0% {
            transform: scale(0.4);
            opacity: 0;
        }

        70% {
            transform: scale(1.12);
        }

        100% {
            transform: scale(1);
            opacity: 1;
        }
    }

    /* ── Side Panel ── */
    .side-panel {
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-width: 210px;
        max-width: 250px;
        flex: 1;
    }

    .panel-card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 14px;
        padding: 18px;
    }

    .panel-card-title {
        font-family: var(--pixel);
        font-size: 9px;
        color: var(--neon);
        text-transform: uppercase;
        letter-spacing: 1px;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .score-row {
        display: flex;
        gap: 10px;
        justify-content: space-between;
    }

    .score-pill {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        background: #0d1525;
        border: 1px solid var(--border);
        border-radius: 10px;
        padding: 10px 8px;
        text-align: center;
    }

        .score-pill.x-pill {
            border-color: #f97316;
        }

        .score-pill.o-pill {
            border-color: #3b82f6;
        }

        .score-pill.d-pill {
            border-color: var(--muted);
        }

        .score-pill .plabel {
            font-size: 9px;
            color: var(--muted);
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .score-pill .pval {
            font-family: var(--pixel);
            font-size: 18px;
            color: var(--yellow);
        }

        .score-pill.x-pill .pval {
            color: #fb923c;
        }

        .score-pill.o-pill .pval {
            color: var(--neon);
        }

    .player-indicator {
        display: flex;
        gap: 10px;
    }

    .player-box {
        flex: 1;
        background: #0d1525;
        border: 2px solid var(--border);
        border-radius: 10px;
        padding: 12px 8px;
        text-align: center;
        transition: all 0.25s ease;
    }

        .player-box.active-x {
            border-color: #f97316;
            box-shadow: 0 0 16px rgba(249,115,22,0.3);
            background: rgba(249,115,22,0.08);
        }

        .player-box.active-o {
            border-color: #3b82f6;
            box-shadow: 0 0 16px rgba(59,130,246,0.3);
            background: rgba(59,130,246,0.08);
        }

        .player-box .plbl {
            font-size: 9px;
            color: var(--muted);
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 4px;
        }

        .player-box .pico {
            font-size: 28px;
        }

    .game-btns {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .gbtn {
        width: 100%;
        border: none;
        border-radius: 10px;
        padding: 11px 14px;
        font-family: var(--body);
        font-size: 13px;
        font-weight: 800;
        cursor: pointer;
        transition: all 0.15s ease;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
    }

    .gbtn-start {
        background: linear-gradient(135deg,#16a34a,#22c55e);
        color: #fff;
        box-shadow: 0 4px 14px rgba(34,197,94,0.3);
    }

    .gbtn-restart {
        background: linear-gradient(135deg,#1d4ed8,#3b82f6);
        color: #fff;
        box-shadow: 0 4px 14px rgba(59,130,246,0.3);
    }

    .gbtn-reset {
        background: linear-gradient(135deg,#d97706,#fbbf24);
        color: #fff;
        box-shadow: 0 4px 14px rgba(251,191,36,0.25);
    }

    .gbtn-exit {
        background: linear-gradient(135deg,#b91c1c,#ef4444);
        color: #fff;
        box-shadow: 0 4px 14px rgba(239,68,68,0.25);
    }

    .gbtn:hover {
        transform: translateY(-2px);
        filter: brightness(1.1);
    }

    .gbtn:active {
        transform: translateY(0);
        filter: brightness(0.95);
    }

    .gbtn i {
        font-size: 16px;
    }

    .history-item {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 6px 8px;
        border-radius: 8px;
        margin-bottom: 4px;
        background: #090e1c;
        font-size: 12px;
        font-weight: 600;
    }

    .hi-round {
        font-family: var(--pixel);
        font-size: 8px;
        color: var(--muted);
        min-width: 24px;
    }

    .hi-result {
        flex: 1;
        color: var(--text);
    }

    .hi-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 7px;
        border-radius: 5px;
    }

        .hi-badge.x-win {
            background: rgba(249,115,22,0.2);
            color: #fb923c;
        }

        .hi-badge.o-win {
            background: rgba(59,130,246,0.2);
            color: var(--neon);
        }

        .hi-badge.draw {
            background: rgba(107,114,128,0.2);
            color: #9ca3af;
        }

    @@media (max-width: 900px) {
        .game-layout {
            flex-direction: column;
            align-items: center;
            gap: 14px;
            padding: 0 10px 30px;
        }

        .canvas-wrap {
            width: min(1200px, calc(100vw - 20px));
        }

        .side-panel {
            max-width: 100%;
            min-width: unset;
            width: 100%;
            flex-direction: row;
            flex-wrap: wrap;
        }

        .panel-card {
            flex: 1;
            min-width: 150px;
        }
    }
</style>

<div class="game-layout">

    <div class="canvas-wrap">
        <canvas id="gameCanvas" width="1200" height="700"></canvas>
        <div class="canvas-overlay" id="overlay">
            <div class="overlay-icon">🎮</div>
            <div class="overlay-title">TIC-TAC-TOE</div>
            <div class="overlay-sub">Press Start Game to begin!</div>
        </div>
    </div>

    <div class="side-panel">

        <div class="panel-card">
            <div class="panel-card-title"><i class="bi bi-trophy-fill"></i> Score</div>
            <div class="score-row">
                <div class="score-pill x-pill"><div class="plabel">Player X</div><div class="pval" id="scoreX">0</div></div>
                <div class="score-pill d-pill"><div class="plabel">Draws</div>  <div class="pval" id="scoreDraw">0</div></div>
                <div class="score-pill o-pill"><div class="plabel">Player O</div><div class="pval" id="scoreO">0</div></div>
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-card-title"><i class="bi bi-person-fill"></i> Players</div>
            <div class="player-indicator">
                <div class="player-box" id="boxX"><div class="plbl">Player X</div><div class="pico">🔥</div></div>
                <div class="player-box" id="boxO"><div class="plbl">Player O</div><div class="pico">💧</div></div>
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-card-title"><i class="bi bi-joystick"></i> Controls</div>
            <div class="game-btns">
                <button class="gbtn gbtn-start" id="startBtn">  <i class="bi bi-play-fill"></i>           Start Game</button>
                <button class="gbtn gbtn-restart" id="restartBtn"><i class="bi bi-arrow-repeat"></i>         Next Round</button>
                <button class="gbtn gbtn-reset" id="resetBtn">  <i class="bi bi-arrow-counterclockwise"></i> Reset Scores</button>
                <button class="gbtn gbtn-exit" id="exitBtn">   <i class="bi bi-box-arrow-left"></i>       Exit</button>
            </div>
        </div>

        <div class="panel-card">
            <div class="panel-card-title"><i class="bi bi-clock-history"></i> Round History</div>
            <div id="historyLog">
                <div style="font-size:12px;color:var(--muted);text-align:center;padding:10px 0;">No rounds yet!</div>
            </div>
        </div>

    </div>
</div>

<script>
    (function(){
        const canvas = document.getElementById("gameCanvas");
        const ctx    = canvas.getContext("2d");
        const W = canvas.width;   // 1200
        const H = canvas.height;  // 700

        // ── Board geometry ────────────────────────────────────────
        const CELL  = 180;
        const GAP   = 10;
        const BOARD = CELL * 3 + GAP * 2;
        const BX    = (W - BOARD) / 2;
        const BY    = (H - BOARD) / 2 - 10;

        // ── State ─────────────────────────────────────────────────
        let board         = Array(3).fill(null).map(()=>Array(3).fill(''));
        let currentPlayer = 'X';
        let gameActive    = false;
        let scores        = {X:0, O:0, D:0};
        let roundNum      = 0;
        let history       = [];
        let winCombo      = null;
        let winAnim       = 0;

        // ── Helpers ───────────────────────────────────────────────
        function cellRect(r, c){
            return { x: BX + c*(CELL+GAP), y: BY + r*(CELL+GAP), w: CELL, h: CELL };
        }

        // ── Render ────────────────────────────────────────────────
        function drawBackground(){
            ctx.fillStyle = "#050a14";
            ctx.fillRect(0, 0, W, H);
            ctx.fillStyle = "rgba(96,165,250,0.035)";
            const DG = 32;
            for(let x=0; x<W; x+=DG) for(let y=0; y<H; y+=DG){
                ctx.beginPath(); ctx.arc(x, y, 1.2, 0, Math.PI*2); ctx.fill();
            }
        }

        function drawCell(r, c){
            const {x, y, w, h} = cellRect(r, c);
            const val  = board[r][c];
            const isWin = winCombo && winCombo.some(([wr,wc])=>wr===r&&wc===c);
            const pulse = isWin ? Math.abs(Math.sin(winAnim * 0.08)) : 0;

            ctx.save();
            ctx.fillStyle = isWin
                ? `rgba(34,197,94,${0.12 + pulse*0.12})`
                : val==='X' ? "rgba(249,115,22,0.08)"
                : val==='O' ? "rgba(59,130,246,0.08)"
                : "#0d1525";
            ctx.shadowColor = isWin
                ? `rgba(34,197,94,${0.3+pulse*0.4})`
                : val==='X' ? "rgba(249,115,22,0.25)"
                : val==='O' ? "rgba(59,130,246,0.25)"
                : "transparent";
            ctx.shadowBlur = isWin ? 30 : (val ? 16 : 0);
            ctx.beginPath(); ctx.roundRect(x, y, w, h, 16); ctx.fill();
            ctx.strokeStyle = isWin
                ? `rgba(34,197,94,${0.7+pulse*0.3})`
                : val==='X' ? "#f97316"
                : val==='O' ? "#3b82f6"
                : "#1e2d4a";
            ctx.lineWidth = isWin ? 3 : 2;
            ctx.stroke();
            ctx.restore();

            if(val === 'X'){
                const pad = 40;
                ctx.save();
                ctx.shadowColor="#f97316"; ctx.shadowBlur=20;
                ctx.strokeStyle="#fb923c"; ctx.lineWidth=14; ctx.lineCap="round";
                ctx.beginPath(); ctx.moveTo(x+pad, y+pad);         ctx.lineTo(x+w-pad, y+h-pad); ctx.stroke();
                ctx.beginPath(); ctx.moveTo(x+w-pad, y+pad);       ctx.lineTo(x+pad,   y+h-pad); ctx.stroke();
                ctx.restore();
            } else if(val === 'O'){
                ctx.save();
                ctx.shadowColor="#3b82f6"; ctx.shadowBlur=20;
                ctx.strokeStyle="#60a5fa"; ctx.lineWidth=14;
                ctx.beginPath(); ctx.arc(x+w/2, y+h/2, CELL/2-38, 0, Math.PI*2); ctx.stroke();
                ctx.restore();
            }
        }

        function drawStatus(){
            let text = "", color = "#60a5fa";
            if(!gameActive && roundNum===0){ text="Press Start Game to begin!"; color="#6b7280"; }
            else if(!gameActive && winCombo){ text=`Player ${currentPlayer} Wins! 🎉`; color=currentPlayer==='X'?"#fb923c":"#60a5fa"; }
            else if(!gameActive && !winCombo && roundNum>0){ text="It's a Draw! 🤝"; color="#fbbf24"; }
            else if(gameActive){ text=`Player ${currentPlayer}'s Turn  ${currentPlayer==='X'?'🔥':'💧'}`; color=currentPlayer==='X'?"#fb923c":"#60a5fa"; }

            ctx.save();
            ctx.font="bold 22px 'Nunito',sans-serif";
            ctx.fillStyle=color; ctx.textAlign="center";
            ctx.shadowColor=color; ctx.shadowBlur=12;
            ctx.fillText(text, W/2, BY - 28);
            ctx.restore();
        }

        function drawScoreBar(){
            const items = [
                {label:"Player X 🔥", val:scores.X, color:"#fb923c"},
                {label:"Draws",       val:scores.D, color:"#9ca3af"},
                {label:"Player O 💧", val:scores.O, color:"#60a5fa"},
            ];
            const boxW=160, boxH=56, gap2=20;
            const totalW = items.length*boxW + (items.length-1)*gap2;
            let sx = (W - totalW) / 2;
            const sy = BY + BOARD + 28;

            items.forEach(item => {
                ctx.save();
                ctx.fillStyle="rgba(13,21,37,0.9)";
                ctx.strokeStyle=item.color; ctx.lineWidth=1.5;
                ctx.shadowColor=item.color; ctx.shadowBlur=8;
                ctx.beginPath(); ctx.roundRect(sx, sy, boxW, boxH, 10); ctx.fill(); ctx.stroke();
                ctx.restore();

                ctx.save();
                ctx.textAlign="center";
                ctx.fillStyle="#6b7280"; ctx.font="700 10px 'Nunito'";
                ctx.fillText(item.label.toUpperCase(), sx+boxW/2, sy+18);
                ctx.fillStyle=item.color; ctx.font="bold 22px 'Press Start 2P',monospace";
                ctx.shadowColor=item.color; ctx.shadowBlur=10;
                ctx.fillText(item.val, sx+boxW/2, sy+44);
                ctx.restore();

                sx += boxW + gap2;
            });
        }

        function render(){
            drawBackground();
            drawStatus();
            for(let r=0; r<3; r++) for(let c=0; c<3; c++) drawCell(r, c);
            drawScoreBar();
            if(winCombo) winAnim++;
        }

        // ── Animation loop ────────────────────────────────────────
        (function loop(){ render(); requestAnimationFrame(loop); })();

        // ── Click ─────────────────────────────────────────────────
        canvas.addEventListener("click", e => {
            if(!gameActive) return;
            const rect = canvas.getBoundingClientRect();
            const mx = (e.clientX - rect.left) * (W / rect.width);
            const my = (e.clientY - rect.top)  * (H / rect.height);

            for(let r=0; r<3; r++) for(let c=0; c<3; c++){
                const {x, y, w, h} = cellRect(r, c);
                if(mx>=x && mx<=x+w && my>=y && my<=y+h){
                    if(board[r][c]) return;
                    board[r][c] = currentPlayer;
                    const result = checkWinner();
                    if(result){
                        gameActive = false;
                        if(result.winner==='Draw'){
                            winCombo=null; scores.D++; addHistory('Draw');
                        } else {
                            winCombo=result.combo; winAnim=0;
                            scores[result.winner]++; addHistory(result.winner);
                        }
                        updateScoreUI(); updatePlayerBoxes();
                        saveSession(result.winner==='Draw'?'Draw':`Player ${result.winner} Win`);
                    } else {
                        currentPlayer = currentPlayer==='X'?'O':'X';
                        updatePlayerBoxes();
                    }
                    return;
                }
            }
        });

        canvas.addEventListener("mousemove", e => {
            if(!gameActive){ canvas.style.cursor="default"; return; }
            const rect = canvas.getBoundingClientRect();
            const mx = (e.clientX-rect.left)*(W/rect.width);
            const my = (e.clientY-rect.top) *(H/rect.height);
            let over=false;
            for(let r=0; r<3; r++) for(let c=0; c<3; c++){
                const {x,y,w,h}=cellRect(r,c);
                if(mx>=x&&mx<=x+w&&my>=y&&my<=y+h&&!board[r][c]){over=true;break;}
            }
            canvas.style.cursor=over?"pointer":"default";
        });

        // ── Game logic ────────────────────────────────────────────
        function checkWinner(){
            const wins=[
                [[0,0],[0,1],[0,2]],[[1,0],[1,1],[1,2]],[[2,0],[2,1],[2,2]],
                [[0,0],[1,0],[2,0]],[[0,1],[1,1],[2,1]],[[0,2],[1,2],[2,2]],
                [[0,0],[1,1],[2,2]],[[0,2],[1,1],[2,0]]
            ];
            for(const combo of wins){
                const [a,b,c_]=combo;
                if(board[a[0]][a[1]]&&board[a[0]][a[1]]===board[b[0]][b[1]]&&board[b[0]][b[1]]===board[c_[0]][c_[1]])
                    return{winner:board[a[0]][a[1]],combo};
            }
            return board.flat().includes('')?null:{winner:'Draw',combo:[]};
        }

        function startNewRound(){
            board=Array(3).fill(null).map(()=>Array(3).fill(''));
            currentPlayer='X'; gameActive=true; winCombo=null; winAnim=0;
            updatePlayerBoxes(); hideOverlay();
        }

        // ── UI helpers ────────────────────────────────────────────
        function updateScoreUI(){
            document.getElementById("scoreX").textContent=scores.X;
            document.getElementById("scoreO").textContent=scores.O;
            document.getElementById("scoreDraw").textContent=scores.D;
        }

        function updatePlayerBoxes(){
            document.getElementById("boxX").className="player-box"+(gameActive&&currentPlayer==='X'?" active-x":"");
            document.getElementById("boxO").className="player-box"+(gameActive&&currentPlayer==='O'?" active-o":"");
        }

        function addHistory(result){ roundNum++; history.unshift({round:roundNum,result}); renderHistory(); }

        function renderHistory(){
            const log=document.getElementById("historyLog");
            if(!history.length){log.innerHTML='<div style="font-size:12px;color:var(--muted);text-align:center;padding:10px 0;">No rounds yet!</div>';return;}
            log.innerHTML=history.slice(0,10).map(h=>{
                let badge,label;
                if(h.result==='Draw'){badge='draw';label='Draw 🤝';}
                else if(h.result==='X'){badge='x-win';label='X Wins 🔥';}
                else{badge='o-win';label='O Wins 💧';}
                return`<div class="history-item">
                    <div class="hi-round">#${h.round}</div>
                    <div class="hi-result">Round ${h.round}</div>
                    <div class="hi-badge ${badge}">${label}</div>
                </div>`;
            }).join('');
        }

        function hideOverlay(){ document.getElementById("overlay").classList.add("hidden"); }

        // ── Buttons ───────────────────────────────────────────────
        document.getElementById("startBtn").addEventListener("click", startNewRound);
        document.getElementById("restartBtn").addEventListener("click",()=>{if(roundNum>0||gameActive)startNewRound();});
        document.getElementById("resetBtn").addEventListener("click",()=>{
            scores={X:0,O:0,D:0};roundNum=0;history=[];
            updateScoreUI();renderHistory();startNewRound();
        });
        document.getElementById("exitBtn").addEventListener("click",()=>{
            if(confirm("Exit to Game Zone?"))window.location.href='/Game/Index';
        });

        function saveSession(result){
            fetch('/Game/SaveSession',{method:'POST',headers:{'Content-Type':'application/json'},
                body:JSON.stringify({gameName:"TicTacToe",score:scores.X+scores.O,durationSeconds:0,result,startedAt:new Date().toISOString()})
            }).catch(()=>{});
        }

        // ── Init ──────────────────────────────────────────────────
        updateScoreUI(); renderHistory(); updatePlayerBoxes();
    })();
</script>
